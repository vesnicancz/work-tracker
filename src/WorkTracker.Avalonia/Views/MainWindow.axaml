<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:material="using:Material.Icons.Avalonia"
        xmlns:wt="using:WorkTracker.Avalonia.Controls"
        xmlns:markup="using:WorkTracker.Avalonia.Markup"
        xmlns:converters="using:WorkTracker.Avalonia.Converters"
        xmlns:vm="using:WorkTracker.Avalonia.ViewModels"
        x:Class="WorkTracker.Avalonia.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        mc:Ignorable="d"
        Title="{markup:Localize AppTitle}"
        Width="1100"
        Height="720"
        MinWidth="750"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent">

    <Window.Resources>
        <converters:TimeSpanToStringConverter x:Key="TimeSpanToStringConverter" />
        <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />
        <converters:NullToBoolConverter x:Key="NullToBoolConverter" />
    </Window.Resources>

    <Panel Margin="8">
        <Border CornerRadius="{DynamicResource WindowCornerRadius}"
                Background="{DynamicResource AppBackground}"
                BorderBrush="{DynamicResource SeparatorColor}"
                BorderThickness="1"
                BoxShadow="{DynamicResource WindowBoxShadow}"
                ClipToBounds="True">
        <Grid>

            <!-- Loading state (visible before initialization completes) -->
            <StackPanel x:Name="LoadingPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="180" Height="3" />
            </StackPanel>

            <!-- Main content (hidden until initialized) -->
            <Grid x:Name="MainContent" RowDefinitions="Auto,*" IsVisible="False">

            <!-- Custom title bar -->
            <Border Grid.Row="0" x:Name="TitleBar"
                    Background="{DynamicResource TitleBarBackground}"
                    BorderBrush="{DynamicResource SeparatorColor}"
                    BorderThickness="{DynamicResource TitleBarBorderThickness}"
                    CornerRadius="{DynamicResource WindowTopCornerRadius}"
                    Height="36">
                <Panel>
                    <!-- App icon (left, fixed) -->
                    <wt:Icon Symbol="app" Size="16"
                             Foreground="{DynamicResource AppTitleForeground}"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Margin="12,0,0,0" />

                    <!-- App title -->
                    <TextBlock Text="{markup:Localize WorkTracker}" FontSize="12"
                               Foreground="{DynamicResource AppTitleForeground}"
                               VerticalAlignment="Center"
                               Margin="34,0,12,0"
                               HorizontalAlignment="{DynamicResource TitleBarAlignment}" />

                    <!-- Window buttons (always right) -->
                    <StackPanel Orientation="Horizontal" Spacing="0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button x:Name="MinimizeButton"
                                Width="36" Height="28" Padding="0"
                                Classes="ghost"
                                ToolTip.Tip="{markup:Localize Minimize}">
                            <wt:Icon Symbol="window-minimize" Size="14"
                                     Foreground="{DynamicResource WindowControlForeground}" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Width="36" Height="28" Padding="0"
                                Classes="ghost"
                                ToolTip.Tip="{markup:Localize Close}">
                            <wt:Icon Symbol="window-close" Size="14"
                                     Foreground="{DynamicResource WindowControlForeground}" />
                        </Button>
                    </StackPanel>
                </Panel>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1" ColumnDefinitions="280,*">

            <!-- ===== Sidebar ===== -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBackground}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="{DynamicResource SidebarBorderThickness}"
                    CornerRadius="{DynamicResource SidebarCornerRadius}"
                    Margin="{DynamicResource SidebarMargin}"
                    Padding="14,14,14,10">
                <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="10">

                    <!-- Active Work -->
                    <Border Classes="card" IsVisible="{Binding IsTracking}"
                            Background="{DynamicResource ActiveCardBackground}"
                            BorderBrush="{DynamicResource ActiveCardBorder}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <wt:Icon Symbol="active-dot" Size="14"
                                         Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center" />
                                <TextBlock Text="{markup:Localize ActiveWork}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center" />
                            </StackPanel>

                            <TextBlock Text="{Binding ElapsedTime}"
                                       FontSize="{DynamicResource TimerFontSize}" FontWeight="Bold"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       Foreground="{DynamicResource TextBright}"
                                       Effect="{DynamicResource TimerGlowEffect}"
                                       HorizontalAlignment="Center" Margin="0,6" />

                            <StackPanel Spacing="3">
                                <TextBlock Text="{Binding ActiveTicketDisplay}"
                                           FontWeight="Medium" Foreground="{DynamicResource TextBright}" FontSize="13" />
                                <TextBlock Text="{Binding ActiveDescriptionDisplay}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextMuted}" />
                            </StackPanel>

                            <Button Command="{Binding StopWorkCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Margin="0,4,0,0"
                                    Classes="danger">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <wt:Icon Symbol="stop" Size="18" />
                                    <TextBlock Text="{markup:Localize StopWork}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Start Work -->
                    <Border Classes="card">
                        <StackPanel Spacing="8">
                            <TextBox Text="{Binding WorkInput, Mode=TwoWay}"
                                     Watermark="{markup:Localize WorkInputHint}"
                                     MaxLength="200">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding StartWorkCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>

                            <TextBlock IsVisible="{Binding DetectedTicketId, Converter={StaticResource NullToBoolConverter}}"
                                       FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}">
                                <Run Text="{Binding DetectedTicketId, Mode=OneWay}" Foreground="{DynamicResource AccentBlue}" FontWeight="SemiBold" />
                                <Run Text=" " />
                                <Run Text="{Binding DetectedDescription, Mode=OneWay}" />
                            </TextBlock>

                            <Button Command="{Binding StartWorkCommand}"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Classes="success">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <wt:Icon Symbol="play" Size="18" />
                                    <TextBlock Text="{markup:Localize StartWork}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Pomodoro Timer -->
                    <Border Classes="card" Padding="12,10"
                            IsVisible="{Binding Pomodoro.IsEnabled}"
                            Background="{Binding PomodoroCardBackground}"
                            BorderBrush="{Binding PomodoroCardBorder}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*">
                                <wt:Icon Grid.Column="0" Symbol="pomodoro" Size="16"
                                         Foreground="{Binding PomodoroTimerForeground, FallbackValue={DynamicResource TextMuted}}"
                                         VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1" Text="{markup:Localize Pomodoro}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBright}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- Running state -->
                            <StackPanel IsVisible="{Binding Pomodoro.IsRunning}" Spacing="6">
                                <TextBlock Text="{Binding Pomodoro.TimeRemaining}"
                                           FontSize="{DynamicResource PomodoroTimerFontSize}" FontWeight="Bold"
                                           FontFamily="{DynamicResource FontFamilyMono}"
                                           HorizontalAlignment="Center"
                                           Effect="{DynamicResource PomodoroGlowEffect}"
                                           Foreground="{Binding PomodoroTimerForeground, FallbackValue={DynamicResource TextBright}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="6">
                                    <TextBlock Text="{Binding Pomodoro.PhaseDisplay}"
                                               FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock Text="·" FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                    <TextBlock Text="{Binding Pomodoro.Count}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                    <Button Command="{Binding Pomodoro.SkipPhaseCommand}"
                                            ToolTip.Tip="{markup:Localize PomodoroSkip}"
                                            Background="Transparent" Padding="6">
                                        <wt:Icon Symbol="skip-next" Size="18"
                                                 Foreground="{DynamicResource TextSecondary}" />
                                    </Button>
                                    <Button Command="{Binding Pomodoro.StopCommand}"
                                            ToolTip.Tip="{markup:Localize PomodoroStop}"
                                            Background="Transparent" Padding="6">
                                        <wt:Icon Symbol="stop" Size="18"
                                                 Foreground="{DynamicResource DangerRed}" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!-- Idle state -->
                            <Button Command="{Binding Pomodoro.StartCommand}"
                                    IsVisible="{Binding !Pomodoro.IsRunning}"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                    Padding="8,6"
                                    Background="Transparent">
                                <TextBlock Text="{markup:Localize PomodoroStart}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Today total -->
                    <Border Classes="card" Padding="12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <wt:Icon Grid.Column="0" Symbol="timer" Size="16"
                                     Foreground="{DynamicResource TextMuted}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1" Text="{markup:Localize Today}"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding TotalDayDuration}"
                                       FontSize="{DynamicResource TodayTotalFontSize}" FontWeight="Bold"
                                       FontFamily="{DynamicResource FontFamilyMono}"
                                       Foreground="{DynamicResource TextBright}"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                </StackPanel>
                </ScrollViewer>

                <!-- Bottom actions (always visible) -->
                <StackPanel Grid.Row="1" Spacing="2" Margin="0,8,0,0">
                    <Separator Margin="0,0,0,6" />
                    <Button Command="{Binding SubmitWorklogCommand}"
                            Classes="ghost"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <wt:Icon Symbol="cloud-upload" Size="16"
                                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{markup:Localize SubmitWorklogs}" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding OpenSettingsCommand}"
                            Classes="ghost"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="10,8">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <wt:Icon Symbol="settings" Size="16"
                                     Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{markup:Localize Settings}" Foreground="{DynamicResource TextSecondary}"
                                       FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Grid>
            </Border>

            <!-- ===== Right: Work Entries ===== -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="16,14,16,14">

                <!-- Toolbar -->
                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <!-- Right actions -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                        <Button Command="{Binding RefreshCommand}"
                                ToolTip.Tip="{markup:Localize Refresh}" Padding="7"
                                Classes="ghost">
                            <wt:Icon Symbol="refresh" Size="16"
                                     Foreground="{DynamicResource TextMuted}" />
                        </Button>
                        <Button Command="{Binding OpenSuggestionsCommand}"
                                IsVisible="{Binding HasSuggestionPlugins}"
                                ToolTip.Tip="{markup:Localize Suggestions}" Padding="7"
                                Classes="ghost">
                            <wt:Icon Symbol="lightbulb" Size="16"
                                     Foreground="{DynamicResource TextPrimary}" />
                        </Button>
                        <Button Command="{Binding AddWorkEntryCommand}"
                                ToolTip.Tip="{markup:Localize AddNewWorkEntry}" Padding="7"
                                Classes="ghost">
                            <wt:Icon Symbol="plus" Size="16"
                                     Foreground="{DynamicResource TextPrimary}" />
                        </Button>
                    </StackPanel>

                    <!-- Date nav -->
                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <Button Command="{Binding PreviousDayCommand}" Padding="5"
                                Classes="ghost"
                                ToolTip.Tip="{markup:Localize PreviousDay}">
                            <wt:Icon Symbol="chevron-left" Size="18"
                                     Foreground="{DynamicResource TextMuted}" />
                        </Button>
                        <CalendarDatePicker SelectedDate="{Binding SelectedDate}"
                                            Width="180" VerticalAlignment="Center" />
                        <Button Command="{Binding GoToTodayCommand}" Padding="5"
                                Classes="ghost"
                                ToolTip.Tip="{markup:Localize GoToToday}">
                            <wt:Icon Symbol="today" Size="18"
                                     Foreground="{DynamicResource TextMuted}" />
                        </Button>
                        <Button Command="{Binding NextDayCommand}" Padding="5"
                                Classes="ghost"
                                ToolTip.Tip="{markup:Localize NextDay}">
                            <wt:Icon Symbol="chevron-right" Size="18"
                                     Foreground="{DynamicResource TextMuted}" />
                        </Button>
                        <TextBlock Text="{markup:Localize WorkEntries}" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- DataGrid -->
                <DataGrid x:Name="WorkEntriesGrid"
                          Grid.Row="1"
                          ItemsSource="{Binding WorkEntries}"
                          SelectedItem="{Binding SelectedWorkEntry}"
                          AutoGenerateColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True"
                          CanUserSortColumns="False"
                          GridLinesVisibility="Horizontal"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          Background="{DynamicResource AppBackground}"
                          BorderThickness="0"
                          DoubleTapped="OnDataGridDoubleTapped">
                    <DataGrid.Columns>
                        <!-- Ticket: legacy themes render plain text, modern themes render mono+accent (design's .ticket-cell) -->
                        <DataGridTemplateColumn Header="{markup:Localize Ticket}" Width="88">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Panel>
                                        <TextBlock Text="{Binding TicketId}"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{DynamicResource IconPackIsLegacy}"
                                                   Padding="{DynamicResource DataGridCellPadding}" />
                                        <TextBlock Text="{Binding TicketId}"
                                                   FontFamily="{DynamicResource FontFamilyMono}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBlue}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{DynamicResource IconPackIsModern}"
                                                   Padding="{DynamicResource DataGridCellPadding}" />
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{markup:Localize Description}" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Padding="{DynamicResource DataGridCellPadding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Time columns: mono -->
                        <DataGridTemplateColumn Header="{markup:Localize Start}" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StartTime, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='HH:mm'}"
                                               FontFamily="{DynamicResource GridTimeFontFamily}"
                                               VerticalAlignment="Center"
                                               Padding="{DynamicResource DataGridCellPadding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{markup:Localize End}" Width="65">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding EndTime, Converter={StaticResource DateTimeToStringConverter}, ConverterParameter='HH:mm', TargetNullValue='—'}"
                                               FontFamily="{DynamicResource GridTimeFontFamily}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"
                                               Padding="{DynamicResource DataGridCellPadding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="{markup:Localize Duration}" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Duration, Converter={StaticResource TimeSpanToStringConverter}}"
                                               FontFamily="{DynamicResource GridTimeFontFamily}"
                                               VerticalAlignment="Center"
                                               Padding="{DynamicResource DataGridCellPadding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status -->
                        <DataGridTemplateColumn Header="{markup:Localize Status}" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Panel VerticalAlignment="Center" HorizontalAlignment="Left"
                                           Margin="{DynamicResource DataGridCellPadding}">
                                        <TextBlock Text="{markup:Localize Active}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SuccessGreen}"
                                                   IsVisible="{Binding IsActive}" />
                                        <TextBlock Text="{markup:Localize Done}" FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   IsVisible="{Binding !IsActive}" />
                                    </Panel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right" Spacing="0"
                                                VerticalAlignment="Center"
                                                Classes="rowActions">
                                        <Button IsVisible="{Binding !IsActive}"
                                                Command="{Binding #WorkEntriesGrid.DataContext.StartWorkFromHistoryCommand}"
                                                CommandParameter="{Binding}"
                                                Width="28" Height="28" Padding="0"
                                                Classes="ghost"
                                                ToolTip.Tip="{markup:Localize RestartWork}">
                                            <wt:Icon Symbol="play" Size="16"
                                                     Foreground="{DynamicResource RowActionPlayColor}" />
                                        </Button>
                                        <Button Command="{Binding #WorkEntriesGrid.DataContext.EditWorkEntryCommand}"
                                                CommandParameter="{Binding}"
                                                Width="28" Height="28" Padding="0"
                                                Classes="ghost"
                                                ToolTip.Tip="{markup:Localize Edit}">
                                            <wt:Icon Symbol="edit" Size="16"
                                                     Foreground="{DynamicResource RowActionEditColor}" />
                                        </Button>
                                        <Button Command="{Binding #WorkEntriesGrid.DataContext.DeleteWorkEntryCommand}"
                                                CommandParameter="{Binding}"
                                                Width="28" Height="28" Padding="0"
                                                Classes="ghost"
                                                ToolTip.Tip="{markup:Localize Delete}">
                                            <wt:Icon Symbol="delete" Size="16"
                                                     Foreground="{DynamicResource RowActionDeleteColor}" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        </Grid>
        </Grid>
        </Border>

        <!-- Notification overlay (above the border, inside Panel margin) -->
        <StackPanel x:Name="NotificationHost"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="{DynamicResource ToasterMargin}"
                    Spacing="4" />
    </Panel>
</Window>
