<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette: Abyss
        Conservative professional dark theme. Deep navy surfaces, bright sky
        blue accent — pure blue, no teal. The night sister of the "Cobalt"
        light theme. Familiar enterprise feel, careful contrast.
    -->

    <!-- Background / Surface -->
    <SolidColorBrush x:Key="AppBackground"       Color="#0E1726" />
    <SolidColorBrush x:Key="SidebarBackground"   Color="#091020" />
    <SolidColorBrush x:Key="SidebarBorder"       Color="#1B2842" />
    <SolidColorBrush x:Key="CardBackground"      Color="#16213A" />
    <SolidColorBrush x:Key="CardBorder"          Color="#243250" />
    <SolidColorBrush x:Key="InputBackground"     Color="#0A1224" />
    <SolidColorBrush x:Key="InputBorder"         Color="#243250" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"         Color="#C5D0E0" />
    <SolidColorBrush x:Key="TextSecondary"       Color="#8896B0" />
    <SolidColorBrush x:Key="TextMuted"           Color="#5A6B86" />
    <SolidColorBrush x:Key="TextBright"          Color="#E8EEF8" />

    <!-- Accent / Status -->
    <SolidColorBrush x:Key="AccentBlue"          Color="#5B9EF8" />
    <SolidColorBrush x:Key="AccentBlueDark"      Color="#4488E0" />
    <SolidColorBrush x:Key="AccentBluePressed"   Color="#3275CC" />
    <SolidColorBrush x:Key="SuccessGreen"        Color="#4ABE82" />
    <SolidColorBrush x:Key="SuccessGreenDark"    Color="#3AA86E" />
    <SolidColorBrush x:Key="SuccessGreenPressed" Color="#2C8E5A" />
    <SolidColorBrush x:Key="DangerRed"           Color="#E47272" />
    <SolidColorBrush x:Key="DangerRedDark"       Color="#CC5C5C" />
    <SolidColorBrush x:Key="DangerRedPressed"    Color="#B04848" />
    <SolidColorBrush x:Key="WarningYellow"       Color="#E5B05F" />
    <SolidColorBrush x:Key="InfoBlue"            Color="#5B9EF8" />
    <SolidColorBrush x:Key="SeparatorColor"      Color="#1F2C46" />

    <!-- Active tracking card (subtle green-tinted surface) -->
    <SolidColorBrush x:Key="ActiveCardBackground" Color="#0F2218" />
    <SolidColorBrush x:Key="ActiveCardBorder"     Color="#1F5A3E" />

    <!-- Pomodoro phase cards -->
    <SolidColorBrush x:Key="PomodoroWorkCardBackground"      Color="#22120F" />
    <SolidColorBrush x:Key="PomodoroWorkCardBorder"           Color="#5A2A28" />
    <SolidColorBrush x:Key="PomodoroBreakCardBackground"      Color="#0F2218" />
    <SolidColorBrush x:Key="PomodoroBreakCardBorder"          Color="#1F5A3E" />
    <SolidColorBrush x:Key="PomodoroLongBreakCardBackground"  Color="#0F1A2C" />
    <SolidColorBrush x:Key="PomodoroLongBreakCardBorder"      Color="#284670" />
    <SolidColorBrush x:Key="PomodoroWorkForeground"           Color="#E47272" />
    <SolidColorBrush x:Key="PomodoroBreakForeground"          Color="#4ABE82" />
    <SolidColorBrush x:Key="PomodoroLongBreakForeground"      Color="#5B9EF8" />

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonSecondaryBg"   Color="#16213A" />
    <SolidColorBrush x:Key="ButtonSecondaryFg"   Color="#C5D0E0" />
    <SolidColorBrush x:Key="AccentButtonFg"      Color="#0A1224" />
    <SolidColorBrush x:Key="WarningButtonBg"        Color="#2A2014" />
    <SolidColorBrush x:Key="WarningButtonBgHover"   Color="#34281A" />
    <SolidColorBrush x:Key="WarningButtonBgPressed"  Color="#3E3120" />
    <SolidColorBrush x:Key="WarningButtonBorder"     Color="#4A3A24" />
    <SolidColorBrush x:Key="WarningButtonFg"         Color="#E5B05F" />

    <!-- Avalonia system overrides -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"           Color="#0E1726" />
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush"          Color="#0E1726" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"                   Color="#0E1726" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush"      Color="#091020" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"          Color="#16213A" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"                  Color="#243250" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"                 Color="#0A1224" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"               Color="#16213A" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"                Color="#1F2C46" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"               Color="#243250" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"             Color="#2E3D5E" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"                    Color="#C5D0E0" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"                  Color="#8896B0" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"                   Color="#5A6B86" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"                   Color="#414E68" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"               Color="#1F2C46" />
    <Color x:Key="SystemAccentColor">#5B9EF8</Color>
    <Color x:Key="SystemAccentColorLight1">#7AB1FA</Color>
    <Color x:Key="SystemAccentColorLight2">#9AC5FC</Color>
    <Color x:Key="SystemAccentColorDark1">#4488E0</Color>
    <Color x:Key="SystemAccentColorDark2">#3275CC</Color>
    <SolidColorBrush x:Key="SuccessBrush"    Color="#4ABE82" />
    <SolidColorBrush x:Key="WarningBrush"    Color="#E5B05F" />
    <SolidColorBrush x:Key="ErrorBrush"      Color="#E47272" />
    <SolidColorBrush x:Key="InfoBrush"       Color="#5B9EF8" />

    <!-- Extended layout parameters -->
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <Thickness x:Key="CardPadding">14</Thickness>

    <!-- Window chrome -->
    <SolidColorBrush x:Key="TitleBarBackground" Color="#091020" />
    <Thickness x:Key="TitleBarBorderThickness">0,0,0,1</Thickness>
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="WindowTopCornerRadius">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="SidebarCornerRadius">0,0,0,8</CornerRadius>
    <Thickness x:Key="SidebarMargin">0</Thickness>
    <Thickness x:Key="SidebarBorderThickness">0,0,1,0</Thickness>
    <SolidColorBrush x:Key="DialogBackground" Color="#091020" />
    <SolidColorBrush x:Key="WindowControlForeground" Color="#8896B0" />
    <SolidColorBrush x:Key="AppTitleForeground"      Color="#5A6B86" />
    <x:Double x:Key="WindowControlIconSize">14</x:Double>
    <x:Double x:Key="ToolbarIconSize">16</x:Double>
    <HorizontalAlignment x:Key="TitleBarAlignment">Left</HorizontalAlignment>
    <x:Boolean x:Key="ShowDialogTitleBar">True</x:Boolean>
    <Thickness x:Key="ToasterMargin">0,0,0,12</Thickness>
    <x:Double x:Key="RowActionsDefaultOpacity">1</x:Double>
    <SolidColorBrush x:Key="RowActionPlayColor" Color="#4ABE82" />
    <SolidColorBrush x:Key="RowActionEditColor" Color="#8896B0" />
    <SolidColorBrush x:Key="RowActionDeleteColor" Color="#E47272" />

    <!-- ============ Theme contract extensions ============ -->
    <BoxShadows x:Key="WindowBoxShadow">0 20 60 -16 #80000000, 0 6 18 -6 #4C000000</BoxShadows>
    <BoxShadows x:Key="CardBoxShadow">0 1 3 0 #33000000</BoxShadows>
    <DropShadowEffect x:Key="TimerGlowEffect" Color="#00000000" BlurRadius="0" Opacity="0" />
    <SolidColorBrush x:Key="AccentSoftBackground"  Color="#225B9EF8" />
    <SolidColorBrush x:Key="SuccessButtonForeground" Color="#0A1224" />
    <SolidColorBrush x:Key="RowHoverBackground"    Color="#14FFFFFF" />
    <SolidColorBrush x:Key="RowSelectedBackground" Color="#2E5B9EF8" />
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
    <x:Double x:Key="DataGridRowMinHeight">34</x:Double>
    <x:Double x:Key="DataGridRowFontSize">12</x:Double>

</ResourceDictionary>
