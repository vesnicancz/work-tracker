<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette: Cobalt
        Conservative professional light theme. Cool slate paper, deep cobalt
        accent, restrained status colors. The classic enterprise sister to
        the "Abyss" dark theme. Calm, focused, no-nonsense.
    -->

    <!-- Background / Surface -->
    <SolidColorBrush x:Key="AppBackground"       Color="#F7F9FC" />
    <SolidColorBrush x:Key="SidebarBackground"   Color="#EEF2F8" />
    <SolidColorBrush x:Key="SidebarBorder"       Color="#DCE3ED" />
    <SolidColorBrush x:Key="CardBackground"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder"          Color="#DCE3ED" />
    <SolidColorBrush x:Key="InputBackground"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder"         Color="#C5CFDE" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"         Color="#1B2536" />
    <SolidColorBrush x:Key="TextSecondary"       Color="#4D5A70" />
    <SolidColorBrush x:Key="TextMuted"           Color="#8693A6" />
    <SolidColorBrush x:Key="TextBright"          Color="#0A1322" />

    <!-- Accent / Status -->
    <SolidColorBrush x:Key="AccentBlue"          Color="#1E5FCC" />
    <SolidColorBrush x:Key="AccentBlueDark"      Color="#1850B0" />
    <SolidColorBrush x:Key="AccentBluePressed"   Color="#134394" />
    <SolidColorBrush x:Key="SuccessGreen"        Color="#1F8A5B" />
    <SolidColorBrush x:Key="SuccessGreenDark"    Color="#19744B" />
    <SolidColorBrush x:Key="SuccessGreenPressed" Color="#135E3C" />
    <SolidColorBrush x:Key="DangerRed"           Color="#C73838" />
    <SolidColorBrush x:Key="DangerRedDark"       Color="#AD2C2C" />
    <SolidColorBrush x:Key="DangerRedPressed"    Color="#922424" />
    <SolidColorBrush x:Key="WarningYellow"       Color="#C77F12" />
    <SolidColorBrush x:Key="InfoBlue"            Color="#1E5FCC" />
    <SolidColorBrush x:Key="SeparatorColor"      Color="#E2E7EF" />

    <!-- Active tracking card (subtle green-tinted surface) -->
    <SolidColorBrush x:Key="ActiveCardBackground" Color="#EAF5EF" />
    <SolidColorBrush x:Key="ActiveCardBorder"     Color="#9ECCB4" />

    <!-- Pomodoro phase cards -->
    <SolidColorBrush x:Key="PomodoroWorkCardBackground"      Color="#FBEAEA" />
    <SolidColorBrush x:Key="PomodoroWorkCardBorder"           Color="#D8A0A0" />
    <SolidColorBrush x:Key="PomodoroBreakCardBackground"      Color="#EAF5EF" />
    <SolidColorBrush x:Key="PomodoroBreakCardBorder"          Color="#9ECCB4" />
    <SolidColorBrush x:Key="PomodoroLongBreakCardBackground"  Color="#E8EFFA" />
    <SolidColorBrush x:Key="PomodoroLongBreakCardBorder"      Color="#A6BDDD" />
    <SolidColorBrush x:Key="PomodoroWorkForeground"           Color="#C73838" />
    <SolidColorBrush x:Key="PomodoroBreakForeground"          Color="#1F8A5B" />
    <SolidColorBrush x:Key="PomodoroLongBreakForeground"      Color="#1E5FCC" />

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonSecondaryBg"   Color="#E6ECF5" />
    <SolidColorBrush x:Key="ButtonSecondaryFg"   Color="#1B2536" />
    <SolidColorBrush x:Key="AccentButtonFg"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarningButtonBg"        Color="#FBF1DE" />
    <SolidColorBrush x:Key="WarningButtonBgHover"   Color="#F6E6C5" />
    <SolidColorBrush x:Key="WarningButtonBgPressed"  Color="#F0DAA8" />
    <SolidColorBrush x:Key="WarningButtonBorder"     Color="#D5B262" />
    <SolidColorBrush x:Key="WarningButtonFg"         Color="#8A5A0A" />

    <!-- Avalonia system overrides -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"           Color="#F7F9FC" />
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush"          Color="#F7F9FC" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"                   Color="#F7F9FC" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush"      Color="#EEF2F8" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"                  Color="#DCE3ED" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"                 Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"               Color="#F1F4F9" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"                Color="#E6ECF5" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"               Color="#C5CFDE" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"             Color="#B0BCCE" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"                    Color="#1B2536" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"                  Color="#4D5A70" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"                   Color="#8693A6" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"                   Color="#B0BCCE" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"               Color="#E2E7EF" />
    <Color x:Key="SystemAccentColor">#1E5FCC</Color>
    <Color x:Key="SystemAccentColorLight1">#4078D5</Color>
    <Color x:Key="SystemAccentColorLight2">#6892DE</Color>
    <Color x:Key="SystemAccentColorDark1">#1850B0</Color>
    <Color x:Key="SystemAccentColorDark2">#134394</Color>
    <SolidColorBrush x:Key="SuccessBrush"    Color="#1F8A5B" />
    <SolidColorBrush x:Key="WarningBrush"    Color="#C77F12" />
    <SolidColorBrush x:Key="ErrorBrush"      Color="#C73838" />
    <SolidColorBrush x:Key="InfoBrush"       Color="#1E5FCC" />

    <!-- Extended layout parameters -->
    <CornerRadius x:Key="CardCornerRadius">6</CornerRadius>
    <Thickness x:Key="CardPadding">14</Thickness>

    <!-- Window chrome -->
    <SolidColorBrush x:Key="TitleBarBackground" Color="#EEF2F8" />
    <Thickness x:Key="TitleBarBorderThickness">0,0,0,1</Thickness>
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="WindowTopCornerRadius">8,8,0,0</CornerRadius>
    <CornerRadius x:Key="SidebarCornerRadius">0,0,0,8</CornerRadius>
    <Thickness x:Key="SidebarMargin">0</Thickness>
    <Thickness x:Key="SidebarBorderThickness">0,0,1,0</Thickness>
    <SolidColorBrush x:Key="DialogBackground" Color="#EEF2F8" />
    <SolidColorBrush x:Key="WindowControlForeground" Color="#4D5A70" />
    <SolidColorBrush x:Key="AppTitleForeground"      Color="#8693A6" />
    <x:Double x:Key="WindowControlIconSize">14</x:Double>
    <x:Double x:Key="ToolbarIconSize">16</x:Double>
    <HorizontalAlignment x:Key="TitleBarAlignment">Left</HorizontalAlignment>
    <x:Boolean x:Key="ShowDialogTitleBar">True</x:Boolean>
    <Thickness x:Key="ToasterMargin">0,0,0,12</Thickness>
    <x:Double x:Key="RowActionsDefaultOpacity">1</x:Double>
    <SolidColorBrush x:Key="RowActionPlayColor" Color="#1F8A5B" />
    <SolidColorBrush x:Key="RowActionEditColor" Color="#4D5A70" />
    <SolidColorBrush x:Key="RowActionDeleteColor" Color="#C73838" />

    <!-- ============ Theme contract extensions ============ -->
    <BoxShadows x:Key="WindowBoxShadow">0 16 48 -16 #1F000000, 0 4 14 -4 #14000000</BoxShadows>
    <BoxShadows x:Key="CardBoxShadow">0 1 3 0 #14000000</BoxShadows>
    <DropShadowEffect x:Key="TimerGlowEffect" Color="#00000000" BlurRadius="0" Opacity="0" />
    <SolidColorBrush x:Key="AccentSoftBackground"  Color="#221E5FCC" />
    <SolidColorBrush x:Key="RowHoverBackground"    Color="#0A000000" />
    <SolidColorBrush x:Key="RowSelectedBackground" Color="#2E1E5FCC" />
    <CornerRadius x:Key="ButtonCornerRadius">4</CornerRadius>
    <x:Double x:Key="DataGridRowMinHeight">34</x:Double>
    <x:Double x:Key="DataGridRowFontSize">12</x:Double>

</ResourceDictionary>
