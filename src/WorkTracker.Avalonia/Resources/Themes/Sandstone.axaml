<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Palette: Sandstone
        Warm cream paper light theme. Terracotta accent + forest green status colors,
        a calm and grown-up sister to the "Eclipse" dark theme.
    -->

    <!-- Background / Surface -->
    <SolidColorBrush x:Key="AppBackground"       Color="#FBF7F0" />
    <SolidColorBrush x:Key="SidebarBackground"   Color="#F1EADB" />
    <SolidColorBrush x:Key="SidebarBorder"       Color="#DCD2BD" />
    <SolidColorBrush x:Key="CardBackground"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorder"          Color="#E4DBC7" />
    <SolidColorBrush x:Key="InputBackground"     Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorder"         Color="#D4C9B1" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimary"         Color="#3A342A" />
    <SolidColorBrush x:Key="TextSecondary"       Color="#6E6553" />
    <SolidColorBrush x:Key="TextMuted"           Color="#9C927E" />
    <SolidColorBrush x:Key="TextBright"          Color="#1F1B14" />

    <!-- Accent / Status -->
    <SolidColorBrush x:Key="AccentBlue"          Color="#B8593A" />
    <SolidColorBrush x:Key="AccentBlueDark"      Color="#9F4A2E" />
    <SolidColorBrush x:Key="AccentBluePressed"   Color="#843C24" />
    <SolidColorBrush x:Key="SuccessGreen"        Color="#5A7D3E" />
    <SolidColorBrush x:Key="SuccessGreenDark"    Color="#4A6932" />
    <SolidColorBrush x:Key="SuccessGreenPressed" Color="#3B5527" />
    <SolidColorBrush x:Key="DangerRed"           Color="#C04E3A" />
    <SolidColorBrush x:Key="DangerRedDark"       Color="#A53F2E" />
    <SolidColorBrush x:Key="DangerRedPressed"    Color="#8B3325" />
    <SolidColorBrush x:Key="WarningYellow"       Color="#C68B2D" />
    <SolidColorBrush x:Key="InfoBlue"            Color="#6B8AA8" />
    <SolidColorBrush x:Key="SeparatorColor"      Color="#E4DBC7" />

    <!-- Active tracking card (sage-tinted surface) -->
    <SolidColorBrush x:Key="ActiveCardBackground" Color="#EEF3E2" />
    <SolidColorBrush x:Key="ActiveCardBorder"     Color="#B5C99A" />

    <!-- Pomodoro phase cards -->
    <SolidColorBrush x:Key="PomodoroWorkCardBackground"      Color="#FCEEE8" />
    <SolidColorBrush x:Key="PomodoroWorkCardBorder"           Color="#DDA08F" />
    <SolidColorBrush x:Key="PomodoroBreakCardBackground"      Color="#EEF3E2" />
    <SolidColorBrush x:Key="PomodoroBreakCardBorder"          Color="#B5C99A" />
    <SolidColorBrush x:Key="PomodoroLongBreakCardBackground"  Color="#E8EEF4" />
    <SolidColorBrush x:Key="PomodoroLongBreakCardBorder"      Color="#A6BCD1" />
    <SolidColorBrush x:Key="PomodoroWorkForeground"           Color="#C04E3A" />
    <SolidColorBrush x:Key="PomodoroBreakForeground"          Color="#5A7D3E" />
    <SolidColorBrush x:Key="PomodoroLongBreakForeground"      Color="#6B8AA8" />

    <!-- Button -->
    <SolidColorBrush x:Key="ButtonSecondaryBg"   Color="#EDE5D2" />
    <SolidColorBrush x:Key="ButtonSecondaryFg"   Color="#3A342A" />
    <SolidColorBrush x:Key="AccentButtonFg"      Color="#FFFFFF" />
    <SolidColorBrush x:Key="WarningButtonBg"        Color="#FBEDD3" />
    <SolidColorBrush x:Key="WarningButtonBgHover"   Color="#F6E3BC" />
    <SolidColorBrush x:Key="WarningButtonBgPressed"  Color="#F0D8A4" />
    <SolidColorBrush x:Key="WarningButtonBorder"     Color="#D9B26A" />
    <SolidColorBrush x:Key="WarningButtonFg"         Color="#8A5C13" />

    <!-- Avalonia system overrides -->
    <SolidColorBrush x:Key="SolidBackgroundFillColorBaseBrush"           Color="#FBF7F0" />
    <SolidColorBrush x:Key="ApplicationPageBackgroundThemeBrush"          Color="#FBF7F0" />
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush"                   Color="#FBF7F0" />
    <SolidColorBrush x:Key="LayerOnMicaBaseAltFillColorDefaultBrush"      Color="#F1EADB" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush"          Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush"                  Color="#E4DBC7" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush"                 Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush"               Color="#F4EEE0" />
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush"                Color="#EDE5D2" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush"               Color="#D4C9B1" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush"             Color="#C7BB9F" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush"                    Color="#3A342A" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush"                  Color="#6E6553" />
    <SolidColorBrush x:Key="TextFillColorTertiaryBrush"                   Color="#9C927E" />
    <SolidColorBrush x:Key="TextFillColorDisabledBrush"                   Color="#BAB1A0" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush"               Color="#E4DBC7" />
    <Color x:Key="SystemAccentColor">#B8593A</Color>
    <Color x:Key="SystemAccentColorLight1">#C97A60</Color>
    <Color x:Key="SystemAccentColorLight2">#D89A87</Color>
    <Color x:Key="SystemAccentColorDark1">#9F4A2E</Color>
    <Color x:Key="SystemAccentColorDark2">#843C24</Color>
    <SolidColorBrush x:Key="SuccessBrush"    Color="#5A7D3E" />
    <SolidColorBrush x:Key="WarningBrush"    Color="#C68B2D" />
    <SolidColorBrush x:Key="ErrorBrush"      Color="#C04E3A" />
    <SolidColorBrush x:Key="InfoBrush"       Color="#6B8AA8" />

    <!-- Extended layout parameters -->
    <CornerRadius x:Key="CardCornerRadius">8</CornerRadius>
    <Thickness x:Key="CardPadding">14</Thickness>

    <!-- Window chrome -->
    <SolidColorBrush x:Key="TitleBarBackground" Color="#F1EADB" />
    <Thickness x:Key="TitleBarBorderThickness">0,0,0,1</Thickness>
    <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="WindowTopCornerRadius">10,10,0,0</CornerRadius>
    <CornerRadius x:Key="SidebarCornerRadius">0,0,0,10</CornerRadius>
    <Thickness x:Key="SidebarMargin">0</Thickness>
    <Thickness x:Key="SidebarBorderThickness">0,0,1,0</Thickness>
    <SolidColorBrush x:Key="DialogBackground" Color="#F1EADB" />
    <SolidColorBrush x:Key="WindowControlForeground" Color="#6E6553" />
    <SolidColorBrush x:Key="AppTitleForeground"      Color="#9C927E" />
    <x:Double x:Key="WindowControlIconSize">14</x:Double>
    <x:Double x:Key="ToolbarIconSize">16</x:Double>
    <HorizontalAlignment x:Key="TitleBarAlignment">Left</HorizontalAlignment>
    <x:Boolean x:Key="ShowDialogTitleBar">True</x:Boolean>
    <Thickness x:Key="ToasterMargin">0,0,0,12</Thickness>
    <x:Double x:Key="RowActionsDefaultOpacity">1</x:Double>
    <SolidColorBrush x:Key="RowActionPlayColor" Color="#5A7D3E" />
    <SolidColorBrush x:Key="RowActionEditColor" Color="#6E6553" />
    <SolidColorBrush x:Key="RowActionDeleteColor" Color="#C04E3A" />

    <!-- ============ Theme contract extensions ============ -->
    <!-- Warm cream paper feel: muted terracotta highlight, gentle elevation. -->
    <BoxShadows x:Key="WindowBoxShadow">0 16 48 -14 #28000000, 0 5 16 -5 #18000000</BoxShadows>
    <BoxShadows x:Key="CardBoxShadow">0 1 3 0 #14000000</BoxShadows>
    <DropShadowEffect x:Key="TimerGlowEffect" Color="#00000000" BlurRadius="0" Opacity="0" />
    <SolidColorBrush x:Key="AccentSoftBackground"  Color="#22B8593A" />
    <SolidColorBrush x:Key="RowHoverBackground"    Color="#0A1F1B14" />
    <SolidColorBrush x:Key="RowSelectedBackground" Color="#24B8593A" />
    <CornerRadius x:Key="ButtonCornerRadius">5</CornerRadius>
    <x:Double x:Key="DataGridRowMinHeight">34</x:Double>
    <x:Double x:Key="DataGridRowFontSize">13</x:Double>

</ResourceDictionary>
