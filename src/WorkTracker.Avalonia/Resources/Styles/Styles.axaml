<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Kill the reserved space for sort icon in DataGrid column headers -->
    <Styles.Resources>
        <x:Double x:Key="DataGridSortIconMinWidth">0</x:Double>
    </Styles.Resources>

    <!-- Window: base background, foreground and font family -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource AppBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyBody}" />
    </Style>

    <!-- Material Symbols Outlined glyph: TextBlock-based icon using ligature text.
         Usage: <TextBlock Classes="symbol" Text="schedule" FontSize="20" Foreground="..." />
         FontWeight Bold maps to the variable font's `wght=700` axis (the heaviest available)
         to match MDI's visual stroke heft. FontSize should be ~125% of an equivalent MDI Width
         because Material Symbols glyphs occupy ~80% of the em-square. -->
    <Style Selector="TextBlock.symbol">
        <Setter Property="FontFamily" Value="{DynamicResource FontFamilyIcon}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <!-- LineHeight = FontSize collapses the font's natural line padding so the glyph
             sits in the geometric centre of the TextBlock bounds (not on the baseline). -->
        <Setter Property="LineHeight" Value="{Binding FontSize, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!-- Card: subtle surface -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}" />
        <Setter Property="Padding" Value="{DynamicResource CardPadding}" />
    </Style>

    <!-- DataGrid: themeable row/header metrics + state colors -->
    <Style Selector="DataGrid">
        <Setter Property="SelectionMode" Value="Single" />
    </Style>
    <Style Selector="DataGridRow">
        <Setter Property="MinHeight" Value="{DynamicResource DataGridRowMinHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource DataGridRowFontSize}" />
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource RowHoverBackground}" />
    </Style>
    <Style Selector="DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
        <Setter Property="Fill" Value="{DynamicResource RowSelectedBackground}" />
    </Style>

    <!-- Column headers: transparent, weight per theme, bottom border only -->
    <Style Selector="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource DataGridHeaderFontSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource DataGridHeaderFontWeight}" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="BorderBrush" Value="{DynamicResource SeparatorColor}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="SeparatorBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Cells: remove default padding so our template cells own padding -->
    <Style Selector="DataGridCell">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- Row actions: opacity controlled by theme, always visible on hover -->
    <Style Selector="StackPanel.rowActions">
        <Setter Property="Opacity" Value="{DynamicResource RowActionsDefaultOpacity}" />
    </Style>
    <Style Selector="DataGridRow:pointerover StackPanel.rowActions">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Hide cell focus rectangle -->
    <Style Selector="DataGridCell:focus /template/ Grid#FocusVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="DataGridCell:current /template/ Grid#FocusVisual">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- CalendarDatePicker: theme-aware styling -->
    <Style Selector="CalendarDatePicker">
        <Setter Property="Background" Value="{DynamicResource InputBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="Padding" Value="7,5,7,5" />
    </Style>

    <!-- Calendar popup: readable text on themed background -->
    <Style Selector="Calendar">
        <Setter Property="Background" Value="{DynamicResource SidebarBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
    </Style>
    <Style Selector="CalendarDayButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="CalendarDayButton:pointerover /template/ ContentControl#Content">
        <Setter Property="Foreground" Value="{DynamicResource TextBright}" />
    </Style>
    <Style Selector="CalendarButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!-- Button: themeable corner radius (applied to every button unless overridden inline) -->
    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="{DynamicResource ButtonCornerRadius}" />
    </Style>

    <!-- Ghost button: transparent surface, no border, accent-soft hover (sidebar + toolbar nav) -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowHoverBackground}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RowSelectedBackground}" />
    </Style>

    <!-- Success button: green, foreground per theme (dark text on bright cyan, white on muted teal) -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource SuccessGreen}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessButtonForeground}" />
    </Style>
    <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessGreenDark}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessButtonForeground}" />
    </Style>
    <Style Selector="Button.success:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SuccessGreenPressed}" />
        <Setter Property="Foreground" Value="{DynamicResource SuccessButtonForeground}" />
    </Style>

    <!-- Danger button: red -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerRed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerRedDark}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource DangerRedPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Warning button: semi-transparent warning color -->
    <Style Selector="Button.warning">
        <Setter Property="Background" Value="{DynamicResource WarningButtonBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource WarningButtonFg}" />
    </Style>
    <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WarningButtonBgHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource WarningButtonFg}" />
    </Style>
    <Style Selector="Button.warning:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource WarningButtonBgPressed}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarningButtonBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource WarningButtonFg}" />
    </Style>

    <!-- Accent button: blue with proper hover/pressed -->
    <Style Selector="Button.accent">
        <Setter Property="Background" Value="{DynamicResource AccentBlue}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonFg}" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBlueDark}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonFg}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBluePressed}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonFg}" />
    </Style>

    <!-- Separator: theme border color -->
    <Style Selector="Separator">
        <Setter Property="Background" Value="{DynamicResource SeparatorColor}" />
        <Setter Property="Height" Value="1" />
    </Style>

</Styles>
